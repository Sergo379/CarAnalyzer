CAR_ANALYZER_ENVIRONMENT=development
CAR_ANALYZER_DATABASE_PATH=data/car_analyzer.db
CAR_ANALYZER_CATALOG_RUNTIME_PATH=data/vehicle_catalog_runtime.json
CAR_ANALYZER_AVITO_BROWSER_DATA_PATH=data/browser/avito
CAR_ANALYZER_DIRECT_PRICE_PERCENT=0.07
CAR_ANALYZER_EXPENSIVE_MAX_PERCENT=0.20
CAR_ANALYZER_CHEAPER_MIN_PERCENT=0.10
CAR_ANALYZER_CHEAPER_MAX_PERCENT=0.20
CAR_ANALYZER_AUTO_RU_BASE_URL=https://auto.ru
CAR_ANALYZER_SCRAPER_TIMEOUT_SECONDS=30
CAR_ANALYZER_TARGET_OPERATION_TIMEOUT_SECONDS=30
CAR_ANALYZER_DISCOVERY_OPERATION_TIMEOUT_SECONDS=40
CAR_ANALYZER_SOURCE_SEARCH_TIMEOUT_SECONDS=42
CAR_ANALYZER_SEARCH_TOTAL_TIMEOUT_SECONDS=50
CAR_ANALYZER_SCRAPER_DETAIL_CONCURRENCY=4
CAR_ANALYZER_SCRAPER_MAX_PAGES=10
CAR_ANALYZER_SCRAPER_MAX_LISTINGS=500
CAR_ANALYZER_CAR_KNOWLEDGE_TTL_DAYS=90
CAR_ANALYZER_KNOWLEDGE_MAX_SEARCH_QUERIES=10
CAR_ANALYZER_KNOWLEDGE_SEARCH_RESULTS_PER_QUERY=3
CAR_ANALYZER_KNOWLEDGE_MAX_SOURCES=10
CAR_ANALYZER_KNOWLEDGE_MAX_SOURCES_PER_DOMAIN=2
CAR_ANALYZER_KNOWLEDGE_SOURCE_TIMEOUT_SECONDS=12
CAR_ANALYZER_KNOWLEDGE_DISCOVERY_TIMEOUT_SECONDS=30
# CAR_ANALYZER_GIGACHAT_CREDENTIALS=
# CAR_ANALYZER_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# CAR_ANALYZER_GIGACHAT_MODEL=GigaChat
